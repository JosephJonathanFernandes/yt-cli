# Optional environment overrides for YouTube Downloader CLI.
# Copy this file to .env and adjust as needed. All values are optional;
# sensible defaults are used when not set. Settings configured via the
# in-app Settings menu take precedence over these.

# Default output directory for downloads.
YTDL_OUTPUT_DIR=

# Path to a cookies.txt file for authenticated/age-restricted content.
YTDL_COOKIE_FILE=

# HTTP/SOCKS proxy URL, e.g. socks5://127.0.0.1:1080
YTDL_PROXY=

# Bandwidth limit, e.g. 1M or 500K
YTDL_RATE_LIMIT=

# Enable verbose/debug logging (true/false).
YTDL_VERBOSE=false
